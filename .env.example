# Export these in your shell; this file is NOT loaded automatically.
SAMACHA_DATA=data
# Required for a non-loopback bind. Use a strong, unique password.
SAMACHA_PASSWORD=
# Additional trusted incoming hosts, separated by commas (no schemes/ports).
SAMACHA_ALLOWED_HOSTS=
# Enable only when served through HTTPS.
SAMACHA_SECURE_COOKIE=0
